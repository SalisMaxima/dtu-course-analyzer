{
  "name": "DTU Course Analyzer 2.6.0",
  "description": "Analyzes and scores courses on kurser.dtu.dk",
  "version": "2.6.0",
  "manifest_version": 3,
  "incognito": "not_allowed",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kurser.dtu.dk/course/*"
      ],
      "js": [
        "js/course-utils.js",
        "js/data-provider.js",
        "contentscript.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon128.png"
  },
  "host_permissions": [
    "https://kurser.dtu.dk/*"
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "db/data.json"
      ],
      "matches": [
        "https://kurser.dtu.dk/*"
      ]
    }
  ],
  "version_name": "2.6.0",
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
